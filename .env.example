# Supabase (cliente)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Secrets de Edge Functions (supabase secrets set KEY=value). Nunca en el cliente.
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# ALLOWED_ORIGINS=https://toolsnocode.com,http://localhost:5173,http://localhost:4173
# SITE_URL=https://toolsnocode.com
# CATEGORY_PAGES_LIVE=true          # solo cuando /categories está en producción
# RESYNC_SECRET=                     # openssl rand -hex 32 — autoriza stripe-resync
# DIGEST_SECRET=                     # openssl rand -hex 32 — autoriza digest; el mismo valor en el entorno de Claude Code
