{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://exlupbihqexeeyxwmveh.supabase.co/functions/v1/sitemap"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/feed"
    },
    {
      "source": "/tools/:slug([a-z0-9-]+)",
      "destination": "/api/page?p=/tools/:slug",
      "missing": [
        {
          "type": "header",
          "key": "x-seo-bypass"
        }
      ]
    },
    {
      "source": "/tools",
      "destination": "/api/page?p=/tools",
      "missing": [
        {
          "type": "header",
          "key": "x-seo-bypass"
        }
      ]
    },
    {
      "source": "/news/:slug([a-z0-9-]+)",
      "destination": "/api/page?p=/news/:slug",
      "missing": [
        {
          "type": "header",
          "key": "x-seo-bypass"
        }
      ]
    },
    {
      "source": "/news",
      "destination": "/api/page?p=/news",
      "missing": [
        {
          "type": "header",
          "key": "x-seo-bypass"
        }
      ]
    },
    {
      "source": "/categories/:slug([a-z0-9-]+)",
      "destination": "/api/page?p=/categories/:slug",
      "missing": [
        {
          "type": "header",
          "key": "x-seo-bypass"
        }
      ]
    },
    {
      "source": "/categories",
      "destination": "/api/page?p=/categories",
      "missing": [
        {
          "type": "header",
          "key": "x-seo-bypass"
        }
      ]
    },
    {
      "source": "/",
      "destination": "/api/page?p=/",
      "missing": [
        {
          "type": "header",
          "key": "x-seo-bypass"
        }
      ]
    },
    {
      "source": "/index.html",
      "destination": "/app.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
