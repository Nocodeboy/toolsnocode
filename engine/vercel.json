{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://PROJECT.supabase.co/functions/v1/sitemap" },
    { "source": "/newsletter/:action(confirm|unsubscribe)", "destination": "https://PROJECT.supabase.co/functions/v1/newsletter?action=:action" },
    { "source": "/feed.xml", "destination": "/api/feed" },

    { "source": "/listings/:slug([a-z0-9-]+)", "destination": "/api/page?p=/listings/:slug", "missing": [{ "type": "header", "key": "x-seo-bypass" }] },
    { "source": "/listings", "destination": "/api/page?p=/listings", "missing": [{ "type": "header", "key": "x-seo-bypass" }] },
    { "source": "/categories/:slug([a-z0-9-]+)/:facet([a-z0-9-]+)", "destination": "/api/page?p=/categories/:slug/:facet", "missing": [{ "type": "header", "key": "x-seo-bypass" }] },
    { "source": "/categories/:slug([a-z0-9-]+)", "destination": "/api/page?p=/categories/:slug", "missing": [{ "type": "header", "key": "x-seo-bypass" }] },
    { "source": "/categories", "destination": "/api/page?p=/categories", "missing": [{ "type": "header", "key": "x-seo-bypass" }] },
    { "source": "/blog/:slug([a-z0-9-]+)", "destination": "/api/page?p=/blog/:slug", "missing": [{ "type": "header", "key": "x-seo-bypass" }] },
    { "source": "/blog", "destination": "/api/page?p=/blog", "missing": [{ "type": "header", "key": "x-seo-bypass" }] },
    { "source": "/", "destination": "/api/page?p=/", "missing": [{ "type": "header", "key": "x-seo-bypass" }] },

    { "source": "/index.html", "destination": "/app.html" },
    { "source": "/:path((?!assets/|api/).*)", "destination": "/api/page?p=/:path", "missing": [{ "type": "header", "key": "x-seo-bypass" }] },
    { "source": "/((?!assets/).*)", "destination": "/app.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
